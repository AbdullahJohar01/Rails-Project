<div id="<%= dom_id book %>">
  <div>
    <strong>Title:</strong>
    <%= book.title %>
  </div>

  <div>
    <strong>Author:</strong>
    <%= book.author %>
  </div>

  <div>
    <strong>Price:</strong>
    <%= number_to_currency(book.price, unit: "Rs. ", precision: 0) %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= book.description %>
  </div>

</div>
